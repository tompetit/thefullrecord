  "slug": "byron-donalds",
  "name": "Byron Donalds",
  "summary": [
    {
      "text": "Byron Donalds is the Republican nominee for governor, running with former state Sen. Bryan Avila. He is the U.S. representative for Florida's 19th District (since 2021) and served in the Florida House from 2016 to 2020. His campaign platform emphasizes homeowners-insurance costs, healthcare price transparency, early-literacy and apprenticeship programs, requiring E-Verify, and cooperation with federal deportation efforts.",
      "sources": [
        "s1",
        "s2",
        "s3",
        "s4",
        "s5",
        "s6"
      ]
    }
  ],
  "paragraphs": [
    [
      {
        "text": "Donalds was born and raised in Crown Heights, Brooklyn, and earned a B.A. in finance and marketing from Florida State University in 2002.",
        "sources": [
          "s1",
          "s7"
        ]
      },
      {
        "text": "He worked in finance, insurance and banking in Southwest Florida before entering politics.",
        "sources": [
          "s1",
          "s7"
        ]
      }
    ],
    [
      {
        "text": "Donalds was elected to the Florida House of Representatives in 2016 and served District 80 until 2020.",
        "sources": [
          "s1",
          "s7"
        ]
      },
      {
        "text": "He was then elected to the U.S. House in 2020 and re-elected in 2022 and 2024.",
        "sources": [
          "s1"
        ]
      },
      {
        "text": "He lives in Naples.",
        "sources": [
          "s7"
        ]
      }
    ]
  ],
