        "s1",
        "s2"
      ]
    }
  ],
  "paragraphs": [
    [
      {
        "text": "Dimanche was born in Florida, graduated from West Orange High School and attended St. Johns River State College.",
        "sources": [
          "s3"
        ]
      },
      {
        "text": "His professional experience includes working in broadcasting and as an author.",
        "sources": [
          "s3"
        ]
      },
      {
        "text": "He received 0.1% of the vote to Byron Donalds's 50%, according to unofficial results reported by NBC News.",
