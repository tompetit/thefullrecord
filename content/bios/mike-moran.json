        "s2"
      ]
    },
    {
      "text": "He is the House Majority Leader.",
      "sources": [
        "s3"
      ]
    }
  ],
  "paragraphs": [
    [
      {
        "text": "Mike Moran earned a bachelor's degree from the University of Massachusetts Boston and attended Don Bosco High School.",
        "sources": [
          "s4"
        ]
      },
      {
        "text": "He has been a member of the Ward 22 Democratic Committee and has served in the Massachusetts House since 2005.",
        "sources": [
          "s4",
          "s1"
        ]
      },
      {
        "text": "He serves on the House Committee on Rules and the Joint Committee on Rules.",
        "sources": [
          "s5"
        ]
      }
