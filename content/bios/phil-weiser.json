  "summary": [
    {
      "text": "Phil Weiser is Colorado's Attorney General, first elected in 2018 and re-elected in 2022, and the Democratic nominee for governor. Before that he was dean of the University of Colorado Law School and served in the Clinton and Obama administrations. His campaign platform emphasizes housing, health care, public safety and defending state laws against federal action.",
      "sources": [
        "s1",
        "s2",
        "s3",
        "s4",
        "s5",
        "s6"
      ]
    }
  ],
  "paragraphs": [
    [
      {
        "text": "Born in New York; B.A. from Swarthmore College (1990) and J.D. from New York University School of Law (1994).",
        "sources": [
          "s1"
        ]
      },
      {
        "text": "Clerked for U.S. Supreme Court Justices Byron White and Ruth Bader Ginsburg; served as senior counsel in the Justice Department's Antitrust Division (1996–1998) and later in the Obama administration.",
        "sources": [
          "s1"
        ]
      },
      {
        "text": "Dean of the University of Colorado Law School, 2011–2016; elected Colorado Attorney General in 2018 and re-elected in 2022.",
        "sources": [
          "s1"
        ]
      }
    ]
  ],
