{
  "slug": "ryan-fazio",
  "name": "Ryan Fazio",
  "summary": [
    {
      "text": "Ryan Fazio, a Republican state senator from Greenwich, lost the November 3, 2026 election for governor of Connecticut to Ned Lamont, having run as the Republican and Independent Party nominee with running mate Matt Corey.",
      "sources": [
        "s1",
        "s2",
        "s3",
        "s4",
        "s8"
      ]
    },
    {
      "text": "First elected in a 2021 special election, he is the ranking senator on the Energy and Technology Committee.",
      "sources": [
        "s1",
        "s2",
        "s3",
        "s4"
      ]
    },
    {
      "text": "His platform centered on cutting income taxes and electricity bills, capping property taxes and a 'Grand Bargain' on housing that protects local zoning control.",
      "sources": [
        "s1",
        "s2",
        "s3",
        "s4"
      ]
    }
  ],
  "paragraphs": [
    [
      {
        "text": "Fazio was born in Norwalk and raised in Greenwich.",
        "sources": [
          "s5"
        ]
      },
      {
        "text": "He earned a B.A. in economics from Northwestern University in 2012.",
        "sources": [
          "s3"
        ]
      },
      {
        "text": "He worked mostly in the commodities industry, in energy, agriculture and shipping, and is now a financial advisor.",
        "sources": [
          "s3",
          "s5"
        ]
      }
    ],
    [
      {
        "text": "Fazio won a special election in August 2021 for the 36th Senate district, which covers Greenwich and parts of Stamford and New Canaan.",
        "sources": [
          "s6",
          "s7"
        ]
      },
      {
        "text": "The win ended the Democratic supermajority in the Senate, and he was re-elected in 2022 and 2024.",
        "sources": [
          "s3"
        ]
      },
      {
        "text": "He received 40.4% of the vote to Ned Lamont's 59.6%, according to unofficial results reported by NBC News.",
        "sources": [
          "s8"
        ]
      }
    ]
  ],
